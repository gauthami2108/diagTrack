# DiagTrack settings for Docker. Setup writes this file as ".env":  docker compose run --rm setup
# No passwords belong here: they are files in the "secrets" folder, also written by setup.
# After changing a value, run:  docker compose up -d

TIME_ZONE=Asia/Kolkata
# Address staff type in the browser; used in email links and QR labels.
SITE_URL=http://diagtrack.local
# First administrator's user name (the password is chosen in setup).
ADMIN_USERNAME=admin

# Backup folders on this computer, for example where the NAS is mounted (mount it with uid=1000).
BACKUP_DIR=./data/backups
BACKUP_DIR_2=./data/backups2

# Front door. Leave SITE_ADDRESS as http:// for plain http inside your network or VPN.
SITE_ADDRESS=http://
HTTPS_MODE=
HTTP_PORT=80
HTTPS_PORT=443
