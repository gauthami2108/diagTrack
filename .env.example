# DiagTrack settings. OPTIONAL: DiagTrack starts without this file.
# To change a default, copy this file to ".env", edit it, and run: docker compose up -d
# Lines starting with # are notes.

# --- Secrets ---
# SECRET_KEY: leave empty; one is created on first start and kept in data/status.
SECRET_KEY=
# DB_PASSWORD: the database is reachable only from inside Docker, so the default is acceptable.
# If you want your own, set it BEFORE the first start and never change it afterwards.
DB_PASSWORD=diagtrack

# --- First administrator login (used only the first time the system starts) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123

# --- Backups ---
# Folder on this server where the NAS is mounted. See docs/01-INSTALL.md, step 6.
BACKUP_DIR=./data/backups
# Time of the nightly backup (24-hour clock) and how many days of copies to keep.
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=30
# Set to 1 once the NAS is mounted, so a disconnected NAS is reported as a failed backup.
BACKUP_REQUIRE_MARKER=0

# --- Address ---
# Leave as is to use plain http://<server-address> inside your network or VPN.
# For HTTPS, see docs/01-INSTALL.md, step 8.
SITE_ADDRESS=http://
HTTPS_MODE=
HTTP_PORT=80
HTTPS_PORT=443

TIME_ZONE=Asia/Kolkata
